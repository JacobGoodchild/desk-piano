{
  "name": "desk-piano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Play piano on a paper keyboard taped to your desk, using a camera and microphone.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs && node tests/e2e.mjs",
