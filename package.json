    "test:e2e": "node tests/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "serve": "http-server -p 8080 -c-1 ."
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
